# ============================================================================
# Scorecard env — Cloudflare + Supabase + VPS. (Vercel is gone.)
# ============================================================================

# ---- VPS generator service (server-side ONLY; never in any browser bundle) --
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY      # writes only; bypasses RLS
PAGESPEED_API_KEY=YOUR-GOOGLE-PAGESPEED-KEY
PLACES_API_KEY=YOUR-GOOGLE-PLACES-KEY                # Door 2 reviews signal
PUBLIC_BASE_URL=https://998webdesigns.com            # no trailing slash
BOOKING_URL=https://998webdesigns.com/book

# screenshots
SUPABASE_STORAGE_BUCKET=scorecard-shots
SCREENSHOT_TIMEOUT_MS=20000

# generator auth (both doors present this as x-generator-key)
# Must match Cloudflare Worker GENERATOR_API_KEY (slatepress/.local/scorecard-generator-api-key.txt)
GENERATOR_API_KEY=long-random-shared-secret

# transactional email (SEPARATE sender domain from the cold-outbound campaign)
RESEND_API_KEY=YOUR-RESEND-KEY
EMAIL_FROM=reports@reports.998webdesigns.com
EMAIL_REPLY_TO=hello@998webdesigns.com
COMPANY_ADDRESS=998 Web Designs, 123 Main St, Little Falls NJ 07424
UNSUBSCRIBE_URL=https://998webdesigns.com/unsubscribe

# dedup window (days) for Door 2 reuse
DEDUP_DAYS=14

# Set to 1 temporarily after fixing site capture — re-shoots recent site thumbnails (~2 per idle cycle)
# SCORECARD_RECAPTURE_SITE_SHOTS=1

# Report B — Awwwards + WebsiteRating intel (operator-only, stored in internal_intel)
# SCORECARD_INTEL_DISABLED=1
# SCORECARD_INTEL_SKIP_WEBSITERATING=1
# SCORECARD_INTEL_TIMEOUT_SEC=25
# SCORECARD_INTEL_PLAYWRIGHT_MS=90000

# operator emails — unlimited Door 2 scans of protected domains (998webdesigns.com)
SCORECARD_INTERNAL_EMAILS=bearllc555@gmail.com,demeos@gmail.com,hello@998webdesigns.com

# ============================================================================
# Cloudflare Pages (set via dashboard or wrangler — NOT in this file on the VPS)
# ============================================================================
# Plain vars:  SUPABASE_URL, SUPABASE_ANON_KEY, BOOKING_URL,
#              RL_IP_PER_HOUR, RL_DOMAIN_PER_DAY
# SECRET:      SUPABASE_SERVICE_ROLE_KEY  (wrangler pages secret put ...)
# KV binding:  RL
#
# The ANON key is the only Supabase key safe for the browser. Even so, the
# Functions read it server-side. The SERVICE-ROLE key is used ONLY inside
# functions/api/scorecard.js (edge, server-side) and never shipped to a client.
