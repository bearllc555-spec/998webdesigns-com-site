# Copy to .env.local — values from slatepress workspace .local/ (gitignored)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: test | live — must match key prefix; surfaces mismatch in GET /api/admin/env-status
STRIPE_EXPECTED_MODE=
# Optional: from node scripts/configure-stripe-billing-portal.mjs (defaults to Stripe portal settings)
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

RESEND_API_KEY=

# Bearer token for GET /api/admin/env-status (generate a long random string)
BALANCE_CAPTURE_SECRET=

# Optional dedicated cron auth for /api/cron/ten-year-hosting (falls back to BALANCE_CAPTURE_SECRET)
CRON_SECRET=

# /crm admin (optional dedicated secret; falls back to BALANCE_CAPTURE_SECRET)
CRM_ADMIN_SECRET=

# Discovery pipeline — SMS verify (Twilio Verify service SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Discovery — book-a-call link shown after intake (/book/schedule)
NEXT_PUBLIC_BOOK_CALL_URL=

# Telegram alerts for leads, contact, payments (create via @BotFather)
# Optional — prefer /crm/telegram UI (saved to crm_telegram_settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
