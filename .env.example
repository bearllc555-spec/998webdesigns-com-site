# Copy to .env.local - values from slatepress workspace .local/ (gitignored)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: test | live - must match key prefix; surfaces mismatch in GET /api/admin/env-status
STRIPE_EXPECTED_MODE=
# Optional: from node scripts/configure-stripe-billing-portal.mjs (defaults to Stripe portal settings)
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

RESEND_API_KEY=

# Homepage voice assistant (Gemini Live) - server only
GEMINI_API_KEY=

# Bearer token for GET /api/admin/env-status (generate a long random string)
BALANCE_CAPTURE_SECRET=

# Optional dedicated cron auth for /api/cron/ten-year-hosting (falls back to BALANCE_CAPTURE_SECRET)
CRON_SECRET=

# /crm admin (optional dedicated secret; falls back to BALANCE_CAPTURE_SECRET)
CRM_ADMIN_SECRET=

# Discovery pipeline - SMS verify (Twilio Verify service SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Promo SMS from voice demo (E.164 sender)
TWILIO_MESSAGING_FROM=

# Calendly webhook signing key (Integrations -> Webhooks -> signing key)
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Discovery - optional Calendly override (Preview/local only; leave unset on Production)
# Canonical: https://calendly.com/998webdesigns/discovery-call-998-web-designs (lib/book-call.ts)
# NEXT_PUBLIC_BOOK_CALL_URL=https://calendly.com/998webdesigns/discovery-call-998-web-designs

# Scorecard VPS worker -> POST /api/scorecard/notify (x-generator-key header)
# Same value as scorecard/generator/.env on the VPS
GENERATOR_API_KEY=

# Telegram alerts for leads, contact, payments (create via @BotFather)
# Optional - prefer /crm/telegram UI (saved to crm_telegram_settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Web Analytics (optional) - token from CF dashboard -> Web Analytics
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Cloudflare deploy (Workers dashboard / wrangler secrets) - same keys as Vercel Production
# APP_ENV=production  # optional override; CF Pages sets CF_PAGES + CF_PAGES_BRANCH automatically
