{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "998: dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready in|✓ Ready|Local:\\s+http)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "998-dev"
      }
    },
    {
      "label": "998: open home in Cursor browser",
      "command": "${input:openHomeSimpleBrowser}",
      "problemMatcher": []
    },
    {
      "label": "998: open CRM in Cursor browser",
      "command": "${input:openCrmSimpleBrowser}",
      "problemMatcher": []
    },
    {
      "label": "998: dev + home tab",
      "dependsOn": ["998: dev server", "998: open home in Cursor browser"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "998: dev + CRM tab",
      "dependsOn": ["998: dev server", "998: open CRM in Cursor browser"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openHomeSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["http://localhost:3000/"]
    },
    {
      "id": "openCrmSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["http://localhost:3000/crm"]
    }
  ]
}
