{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "998webdesigns-com-site",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "alias": {
    "pg": "./cloudflare-shims/pg.js",
    "pg-cloudflare": "./cloudflare-shims/pg-cloudflare.js"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "998webdesigns-com-site"
    }
  ],
  "vars": {
    "HOST_PLATFORM": "cloudflare-workers",
    "APP_ENV": "production"
  },
  "routes": [
    {
      "pattern": "998webdesigns.com",
      "custom_domain": true
    },
    {
      "pattern": "www.998webdesigns.com",
      "custom_domain": true
    }
  ]
}
